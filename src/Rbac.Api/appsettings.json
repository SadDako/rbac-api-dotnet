{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "rbac-api",
    "Version": "1.0.0"
  },
  "Jwt": {
    "Issuer": "Rbac.Api",
    "Audience": "Rbac.Api",
    "Key": "",
    "AccessTokenExpiresMinutes": 15,
    "RefreshTokenExpiresDays": 7,
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}

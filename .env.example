# ============================================================
#  Rbac.Api — example environment variables
#  Copy this file to `.env` and replace placeholders.
#  NEVER commit a populated `.env` to git.
# ============================================================

# ----- ASP.NET Core --------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ----- PostgreSQL ----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rbac

# Used by the API to connect to PostgreSQL.
# In docker-compose the host should be `postgres`; locally use `localhost`.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=rbac;Username=postgres;Password=change_me

# ----- JWT -----------------------------------------------------------
# Must be >= 32 bytes (256-bit). Generate with:
#   openssl rand -base64 48
Jwt__Key=REPLACE_WITH_RANDOM_256BIT_STRING_AT_LEAST_32_CHARS
Jwt__Issuer=Rbac.Api
Jwt__Audience=Rbac.Api
Jwt__AccessTokenExpiresMinutes=15
Jwt__RefreshTokenExpiresDays=7
Jwt__ClockSkewSeconds=60

# ----- CORS ----------------------------------------------------------
# Comma-separated list translated into Cors:AllowedOrigins:0, :1, ... below.
# In production this MUST be set; otherwise the API will refuse to start.
Cors__AllowedOrigins__0=https://localhost:7147
Cors__AllowedOrigins__1=http://localhost:5173

# ----- Redis (optional, used for distributed cache + threat cache) ---
Redis__ConnectionString=

# ----- Bootstrap admin (only runs on first startup) ------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Forwarded headers (when running behind a reverse proxy) -------
# Pin trusted proxy IPs to mitigate X-Forwarded-For spoofing.
ForwardedHeaders__KnownProxies__0=

# ----- Observability (optional) --------------------------------------
Service__Name=rbac-api
Service__Version=1.0.0

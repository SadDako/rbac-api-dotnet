{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Rbac.Api",
    "Audience": "Rbac.Api",
    "Key": "YOUR_SECRET_KEY_FROM_ENVIRONMENT",
    "ExpiresMinutes": 15,
    "RefreshTokenExpiresDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7147" ]
  },
  "AllowedHosts": "*"
}
